  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "How to Play\r\nSelect a mission by clicking on the mission buttons with
    green highlighted text.\r\nRead the mission description.\r\nDrag and Drop one
    of three agents onto the drop zone.\r\nEach mission will test all three skills
    for the agent assigned to the mission. \nYou must succeed 2 out of 3 skill checks
    to complete a mission. \r\nAgents who fail a mission will be injured for a time,
    injured agents who fail missions will die. \r\nCompleted Missions reward Legitimacy,
    failed missions reduce your Secrecy.\r\nIncrease your Legitimacy to win, reduce
    all your secrecy to lose.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1f0a3b7508a8f8743a8c01740bef1841, type: 2}

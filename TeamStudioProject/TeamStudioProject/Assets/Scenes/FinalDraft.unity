  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionButton
  isAvailable: 1
  mission:
    missionName: Forge the Will
    missionDescription: "Gaeso Seius Cicero has recently taken ill and the specter
      of death hangs low over him. What the fool lacked in children, he more than
      made up for in coin, his lonely estate lies empty and ripe for the picking.
      \r\n\r\n\r\nSend someone <b>subtle</b> to convince old Cicero that his vast
      resources would put to better use in our hands instead of our enemies coffers;
      or worse: the state.\r\n"
    turns:
    - turnDescription: 
      requiresCheck: 1
      conflictTarget: 2
      guileTarget: 8
      rhetoricTarget: 4
      successText: Success!
      failText: Failure!
      successOutcomes:
      - statName: Legitimacy
        amount: 12
      failureOutcomes:
      - statName: Secrecy
        amount: -20
      successAgentOutcomes: []
      failureAgentOutcomes: []
      failureKillsAgent: 0
      endsMissionOnFailure: 1
  maxAssignedAgents: 1
  missionsToUnlock:
  - {fileID: 1493443962}
  - {fileID: 1111331865}
  lockAfterCompletion: 1

  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b3185d1c09b621244825ad9d981c680d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionButton
  isAvailable: 1
  mission:
    missionName: Punch a Pleb
    missionDescription: A pleb seeks to rise above his station. Time to put him back
      in his place.
    turns:
    - turnDescription: The pleb lives in a dirty tenement building. He may be hard
        to find.
      requiresRoll: 1
      statToTest: Guile
      difficultyClass: 5
      successText: Success! The pleb has been found without raising alarm.
      failText: Failure, this pleb calls for help!
      successOutcomes: []
      failureOutcomes:
      - statName: Secrecy
        amount: -5
      successAgentOutcomes:
      - statName: SkillPoints
        amount: 1
      failureAgentOutcomes: []
      failureKillsAgent: 0
      endsMissionOnFailure: 0
    - turnDescription: The Pleb puts up a fight!
      requiresRoll: 1
      statToTest: Conflict
      difficultyClass: 15
      successText: Success! You punch the pleb!
      failText: Failure! The Pleb punches you!
      successOutcomes:
      - statName: Legitimacy
        amount: 12
      failureOutcomes:
      - statName: Legitimacy
        amount: -5
      successAgentOutcomes: []
      failureAgentOutcomes: []
      failureKillsAgent: 1
      endsMissionOnFailure: 0
    - turnDescription: Violence does not go unnoticed. A crowd forms and demands
        an explaination.
      requiresRoll: 1
      statToTest: Rhetoric
      difficultyClass: 10
      successText: Success! The crown is convinced to disperse.
      failText: Failure! The crowd becomes an angry mob!
      successOutcomes: []
      failureOutcomes:
      - statName: Secrecy
        amount: -10
      successAgentOutcomes:
      - statName: SkillPoints
        amount: 1
      failureAgentOutcomes: []
      failureKillsAgent: 0
      endsMissionOnFailure: 0
  missionsToUnlock:
  - {fileID: 582151443}
  lockAfterCompletion: 1
  missionManager: {fileID: 722015830}

  m_EditorClassIdentifier: Assembly-CSharp::MissionButton
  isAvailable: 0
  mission:
    missionName: Broker the Blackmail
    missionDescription: "We\u2019ve been presented with a rare opportunity to remove
      a rock from our sandal, a rock named Lucius Manlius Calvus. Last seen leaving
      the home of Vispania II, our agents were able to corral the rumor before it
      broke. Now\u2019s our chance to convince him to support our bid for duumvir.
      We\u2019ll need someone charismatic to keep Calvus in our pocket while the
      knowledge of his affair disappears. "
    turns:
    - turnDescription: The Pleb puts up a fight!
      requiresCheck: 1
      conflictTarget: 2
      guileTarget: 4
      rhetoricTarget: 8
      successText: Success!
      failText: Failure!
      successOutcomes:
      - statName: Legitimacy
        amount: 12
      failureOutcomes:
      - statName: Secrecy
        amount: -20
      successAgentOutcomes: []
      failureAgentOutcomes: []
      failureKillsAgent: 0
      endsMissionOnFailure: 1
  maxAssignedAgents: 1
  missionsToUnlock:
  - {fileID: 116507514}
  - {fileID: 977600294}
  lockAfterCompletion: 1

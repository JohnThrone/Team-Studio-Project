  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionManager
  missions:
  - missionName: First Mission
    missionDescription: Discription of First Mission. 6 turns. Agent stat Conflict
      will be testsed twice, raised on success and lowered by failure. Completion
      of mission player Legitimacy is raised by 10
    turns:
    - turnDescription: A mission starts. Assigncagents by drop and draging their
        character portrait.
      requiresRoll: 1
      statToTest: Conflict
      difficultyClass: 1
      successText: You are ready for the mission
      failText: You did not assign any agents to the mission! Mission Failure
      successOutcomes: []
      failureOutcomes: []
      successAgentOutcomes: []
      failureAgentOutcomes: []
      failureKillsAgent: 0
      endsMissionOnFailure: 1
    - turnDescription: The player gets information about the mission. No skill check.
      requiresRoll: 0
      statToTest: 
      difficultyClass: 0
      successText: 
      failText: 
      successOutcomes:
      - statName: 
        amount: 0
      failureOutcomes: []
      successAgentOutcomes: []
      failureAgentOutcomes: []
      failureKillsAgent: 0
      endsMissionOnFailure: 0
    - turnDescription: Conflict stat is checked. Difficulty 1
      requiresRoll: 1
      statToTest: Conflict
      difficultyClass: 1
      successText: Conflict Check Passed!
      failText: Conflict Check Failed!
      successOutcomes: []
      failureOutcomes: []
      successAgentOutcomes: []
      failureAgentOutcomes: []
      failureKillsAgent: 0
      endsMissionOnFailure: 0
    - turnDescription: Conflict stat is checked. Difficulty 1. Success raises agent
        conflict by 5
      requiresRoll: 1
      statToTest: Conflict
      difficultyClass: 1
      successText: Conflict Check Passed!
      failText: Conflict Check Failed!
      successOutcomes: []
      failureOutcomes: []
      successAgentOutcomes:
      - statName: Conflict
        amount: 5
      failureAgentOutcomes: []
      failureKillsAgent: 0
      endsMissionOnFailure: 0
    - turnDescription: Conflict stat is checked. Difficulty 10. Failure lowers agent
        conflict by 5.
      requiresRoll: 1
      statToTest: Conflict
      difficultyClass: 10
      successText: Conflict Check Passed!
      failText: Conflict Check Failed!
      successOutcomes: []
      failureOutcomes: []
      successAgentOutcomes: []
      failureAgentOutcomes:
      - statName: Conflict
        amount: -5
      failureKillsAgent: 0
      endsMissionOnFailure: 0
    - turnDescription: Mission is completed. Player Legitimacy is increased!

  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionButton
  isAvailable: 0
  mission:
    missionName: Poison the Well of Gossip
    missionDescription: "With Calvus under our thumb, there remains one true frontrunner
      for the title of duumvir: Quintus Fabius Strabo. Luckily for us his son has
      attracted several scandals in the shadows over the years. This time our agent
      will fabricate a rumor to ruin his chances at opposing us. It is imperative
      the source of this rumor stays anonymous, lest it lead back to us and ruin
      all the work we\u2019ve done."
    turns:
    - turnDescription: The Pleb puts up a fight!
      requiresCheck: 1
      conflictTarget: 0
      guileTarget: 10
      rhetoricTarget: 6
      successText: Success!
      failText: Failure!
      successOutcomes:
      - statName: Legitimacy
        amount: 12
